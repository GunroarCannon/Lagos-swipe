# --- Vatar / Lagos Life (from https://lagoslife.app/developers) -------------------------------
# Test secret while you build in the sandbox (vtr_test_…), the live one (vtr_live_…) after approval.
VATAR_SECRET=
# Webhook signing secret is not used yet (the game verifies purchases with the API instead).
#
# Products that must exist in your dashboard, with these exact ids and prices (naira, whole numbers):
#   lucky_charms_5    ₦100     →   5 lucky charms
#   lucky_charms_20   ₦300     →  20 lucky charms
#   naira_100         ₦100     →  ₦50,000 in the bank
#   naira_500         ₦500     →  ₦275,000 in the bank
#   naira_2000        ₦2,000   →  ₦1,200,000 in the bank
# Prices are shown to the player from Vatar's records, so they must match lib/api.js PRODUCTS.

# --- Google Gemini: reading a player's Lagos Life photo into their default look ----------------
# https://aistudio.google.com/apikey — one small call per photo, cached on the player, so a player
# costs one call ever. Without it the game falls back to a free on-device colour sample.
GEMINI_KEY=
# Optional: comma-separated, tried in order. Default: gemini-3-flash-preview,gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3-flash-preview,gemini-3.1-flash-lite

# --- Database: Upstash Redis (free tier). Either set of names works. ---------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Optional ------------------------------------------------------------------------------
# Accept dev sessions even though VATAR_SECRET is set (staging only!). Leave unset in production.
# ALLOW_DEV=1
PORT=3000
