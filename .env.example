# --- Vatar / Lagos Life (from https://lagoslife.app/developers) -------------------------------
# Test secret while you build in the sandbox (vtr_test_…), the live one (vtr_live_…) after approval.
VATAR_SECRET=
# Webhook signing secret is not used yet (the game verifies purchases with the API instead).

# --- Database: Upstash Redis (free tier). Either set of names works. ---------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Optional ------------------------------------------------------------------------------
# Accept dev sessions even though VATAR_SECRET is set (staging only!). Leave unset in production.
# ALLOW_DEV=1
PORT=3000
